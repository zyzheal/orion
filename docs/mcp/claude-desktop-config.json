{
  "mcpServers": {
    "orion-devops": {
      "command": "node",
      "args": ["dist/mcp-server.js"],
      "env": {
        "ORION_API_URL": "http://localhost:3001",
        "ORION_API_KEY": "orion-your-api-key-here"
      }
    },
    "orion-devops-remote": {
      "url": "http://localhost:3001/api/v1/mcp",
      "headers": {
        "x-api-key": "orion-your-api-key-here"
      }
    }
  },
  "instructions": [
    "1. Replace 'orion-your-api-key-here' with your actual Orion API key",
    "2. For local development, ensure Orion platform service is running on port 3001",
    "3. The 'orion-devops' config uses stdio transport (spawn a subprocess)",
    "4. The 'orion-devops-remote' config uses HTTP transport (remote server)",
    "5. Choose one configuration based on your deployment setup"
  ],
  "capabilities": {
    "tools": [
      "pipeline_trigger - Trigger pipeline execution",
      "pipeline_status - Query pipeline run status",
      "pipeline_cancel - Cancel running pipeline",
      "pipeline_logs - Get pipeline execution logs",
      "deployment_list - Query deployment list",
      "deployment_status - Query deployment status",
      "deployment_rollback - Rollback deployment",
      "ticket_create - Create new ticket/issue",
      "ticket_list - Query ticket list",
      "ticket_update - Update ticket status",
      "ticket_assign - Assign ticket to user",
      "diagnostic_run - Run diagnostic analysis",
      "diagnostic_result - Query diagnostic results",
      "selfhealing_trigger - Trigger self-healing action",
      "cost_query - Query cloud cost data",
      "cost_anomaly - Detect cost anomalies",
      "cost_forecast - Forecast future costs"
    ],
    "resources": [
      "projects://list - List all projects",
      "projects://{id} - Project details",
      "pipelines://list - List all pipelines",
      "pipelines://{id}/runs - Pipeline run history",
      "pipelines://{id}/config - Pipeline configuration",
      "deployments://list - List deployments",
      "deployments://{id} - Deployment details",
      "deployments://env/{env} - Deployments by environment",
      "metrics://dora - DORA metrics",
      "metrics://efficiency - Efficiency metrics",
      "metrics://cost - Cost metrics"
    ]
  }
}