# Orion Efficiency Service Configuration
# Copy to .env and fill in values

# Server
NODE_ENV=development
PORT=3015
HOST=0.0.0.0

# Database
DATABASE_URL=postgresql://orion:orion123@localhost:5432/efficiency_db

# Redis (optional)
REDIS_URL=redis://localhost:6379

# Logging
LOG_LEVEL=info
LOG_FORMAT=pretty

# JWT (if applicable)
JWT_SECRET=change-me-in-production
