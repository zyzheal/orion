# ============================================================
# Server
# ============================================================
NODE_ENV=development
PORT=3100
HOST=0.0.0.0
LOG_LEVEL=debug

# ============================================================
# Database
# ============================================================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/orion_ticket?schema=public

# ============================================================
# Redis
# ============================================================
REDIS_URL=redis://localhost:6379

# ============================================================
# CORS
# ============================================================
CORS_ORIGIN=*

# ============================================================
# Rate Limiting
# ============================================================
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=60

# ============================================================
# JWT / Auth
# ============================================================
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=24h

# ============================================================
# External Services
# ============================================================

# Orion Monitor Service (告警转工单)
ORION_MONITOR_SVC_URL=http://localhost:3200

# Orion Intelligence Service (AI 分类/推荐)
ORION_INTELLIGENCE_SVC_URL=http://localhost:3300

# Orion Knowledge Service (知识库)
ORION_KNOWLEDGE_SVC_URL=http://localhost:3400

# Orion Platform Core (租户、用户服务)
ORION_PLATFORM_CORE_URL=http://localhost:3000

# ============================================================
# Notification
# ============================================================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASSWORD=change-me
SMTP_FROM=orion-ticket@example.com

# DingTalk webhook
DINGTALK_WEBHOOK_URL=
# WeWork webhook
WEWORK_WEBHOOK_URL=
