# Environment Variables

# Server
NODE_ENV=development
PORT=3100
HOST=0.0.0.0

# Redis (agent state persistence)
REDIS_URL=redis://localhost:6379

# Sandbox Configuration
# Base image for sandbox containers
SANDBOX_IMAGE=alpine:3.20
# Maximum execution time per task (seconds)
SANDBOX_TIMEOUT=300
# Memory limit per sandbox (e.g., 512m, 1g)
SANDBOX_MEMORY_LIMIT=512m
# CPU limit per sandbox (e.g., 1.0, 2.0)
SANDBOX_CPU_LIMIT=1.0
# Network mode for sandbox (none | bridge)
SANDBOX_NETWORK=none
# Read-only root filesystem
SANDBOX_READONLY_ROOT=true
# Drop all Linux capabilities
SANDBOX_DROP_CAPS=true

# Heartbeat Configuration
# Expected heartbeat interval (seconds)
HEARTBEAT_INTERVAL=15
# Seconds before agent considered dead
HEARTBEAT_DEAD_THRESHOLD=60
# Seconds before agent considered stale
HEARTBEAT_STALE_THRESHOLD=30

# Auto-scaling
# Maximum number of concurrent runners
MAX_RUNNERS=10
# Cooldown between scaling actions (seconds)
SCALING_COOLDOWN=60
# CPU utilization threshold to scale up (percentage)
SCALE_UP_THRESHOLD=80
# CPU utilization threshold to scale down (percentage)
SCALE_DOWN_THRESHOLD=20

# API
# Rate limit per IP (requests per minute)
RATE_LIMIT=100
