{
  "name": "@orion-knowledge",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "icon": "pnpm --filter @orion-knowledge/icons icon",
    "prepare": "cd ../ && husky web/.husky",
