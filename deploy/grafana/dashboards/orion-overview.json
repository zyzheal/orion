{
  "uid": "orion-overview-v1",
  "title": "Orion Platform Overview",
  "description": "Orion platform overview: request volume, latency, error rate, active tenants",
  "tags": ["orion", "platform", "overview"],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 0,
  "refresh": "30s",
  "schemaVersion": 38,
  "version": 1,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Traffic Summary",
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0}
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Total Requests (5m)",
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 1},
      "options": {
        "colorMode": "value",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["sum"], "values": false, "missing": "hide"},
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 10000}]},
          "color": {"mode": "thresholds"}
        },
        "overrides": []
      },
      "targets": [{"expr": "sum(rate(orion_http_requests_total[5m]))", "refId": "A"}]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Success Rate (5m)",
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 1},
      "options": {
        "colorMode": "background",
        "textMode": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "values": false, "missing": "hide"},
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "orange", "value": 0.95}, {"color": "green", "value": 0.99}]},
          "decimals": 3,
          "color": {"mode": "thresholds"}
        },
        "overrides": []
      },
      "targets": [{"expr": "sum(rate(orion_http_requests_total{status=~\"2..|3..\"}[5m])) / sum(rate(orion_http_requests_total[5m]))", "refId": "A"}]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Error Rate (5m)",
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 1},
      "options": {
        "colorMode": "background",
        "textMode": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "values": false, "missing": "hide"},
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 0.01}, {"color": "red", "value": 0.05}]},
          "decimals": 3,
          "color": {"mode": "thresholds"}
        },
        "overrides": []
      },
      "targets": [{"expr": "sum(rate(orion_http_requests_total{status=~\"4..|5..\"}[5m])) / sum(rate(orion_http_requests_total[5m]))", "refId": "A"}]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Active Tenants (est.)",
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 1},
      "options": {
        "colorMode": "value",
        "textMode": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "values": false, "missing": "hide"},
        "showThresholdLabels": false,
        "showThresholdMarkers": false
      },
      "fieldConfig": {
        "defaults": {"unit": "none", "color": {"mode": "thresholds"}},
        "overrides": []
      },
      "targets": [{"expr": "count(count(orion_http_requests_total) by (handler))", "refId": "A", "description": "Estimated active tenants from unique handler label cardinality"}]
    },
    {
      "id": 6,
      "type": "row",
      "title": "Latency",
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 5}
    },
    {
      "id": 7,
      "type": "stat",
      "title": "P50 Latency (5m)",
      "gridPos": {"h": 4, "w": 4, "x": 0, "y": 6},
      "options": {
        "colorMode": "value",
        "textMode": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "values": false, "missing": "hide"},
        "showThresholdLabels": false,
        "showThresholdMarkers": false
      },
      "fieldConfig": {
        "defaults": {"unit": "s", "decimals": 4, "color": {"mode": "thresholds"}},
        "overrides": []
      },
      "targets": [{"expr": "histogram_quantile(0.50, sum(rate(orion_http_requests_duration_seconds_bucket[5m])) by (le))", "refId": "A"}]
    },
    {
      "id": 8,
      "type": "stat",
      "title": "P95 Latency (5m)",
      "gridPos": {"h": 4, "w": 4, "x": 4, "y": 6},
      "options": {
        "colorMode": "value",
        "textMode": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "values": false, "missing": "hide"},
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 4,
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 0.5}, {"color": "red", "value": 1.0}]},
          "color": {"mode": "thresholds"}
        },
        "overrides": []
      },
      "targets": [{"expr": "histogram_quantile(0.95, sum(rate(orion_http_requests_duration_seconds_bucket[5m])) by (le))", "refId": "A"}]
    },
    {
      "id": 9,
      "type": "stat",
      "title": "P99 Latency (5m)",
      "gridPos": {"h": 4, "w": 4, "x": 8, "y": 6},
      "options": {
        "colorMode": "value",
        "textMode": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "values": false, "missing": "hide"},
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 4,
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 1.0}, {"color": "red", "value": 5.0}]},
          "color": {"mode": "thresholds"}
        },
        "overrides": []
      },
      "targets": [{"expr": "histogram_quantile(0.99, sum(rate(orion_http_requests_duration_seconds_bucket[5m])) by (le))", "refId": "A"}]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Request Rate Over Time",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 10},
      "options": {
        "legend": {"displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"]},
        "tooltip": {"mode": "multi", "sort": "none"},
        "seriesOverrides": []
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": {"mode": "palette-classic"},
          "custom": {"axisCenteredZero": false, "axisColorMode": "text", "axisPlacement": "auto", "barAlignment": 0, "drawStyle": "line", "fillOpacity": 10, "gradientMode": "none", "lineInterpolation": "linear", "lineWidth": 1, "pointSize": 5, "scaleDistribution": {"type": "linear"}, "showPoints": "never", "spanNulls": false, "stacking": {"group": "A", "mode": "none"}, "thresholdsStyle": {"mode": "off"}}
        },
        "overrides": []
      },
      "targets": [
        {"expr": "sum(rate(orion_http_requests_total[5m]))", "legendFormat": "Total", "refId": "A"},
        {"expr": "sum(rate(orion_http_requests_total{status=~\"2..|3..\"}[5m]))", "legendFormat": "Success", "refId": "B"},
        {"expr": "sum(rate(orion_http_requests_total{status=~\"4..\"}[5m]))", "legendFormat": "4xx", "refId": "C"},
        {"expr": "sum(rate(orion_http_requests_total{status=~\"5..\"}[5m]))", "legendFormat": "5xx", "refId": "D"}
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Latency Distribution (P50 / P95 / P99)",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 10},
      "options": {
        "legend": {"displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"]},
        "tooltip": {"mode": "multi", "sort": "none"},
        "seriesOverrides": []
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {"axisCenteredZero": false, "axisColorMode": "text", "axisPlacement": "auto", "barAlignment": 0, "drawStyle": "line", "fillOpacity": 10, "gradientMode": "none", "lineInterpolation": "linear", "lineWidth": 1, "pointSize": 5, "scaleDistribution": {"type": "linear"}, "showPoints": "never", "spanNulls": false, "stacking": {"group": "A", "mode": "none"}, "thresholdsStyle": {"mode": "off"}}
        },
        "overrides": []
      },
      "targets": [
        {"expr": "histogram_quantile(0.50, sum(rate(orion_http_requests_duration_seconds_bucket[5m])) by (le))", "legendFormat": "P50", "refId": "A"},
        {"expr": "histogram_quantile(0.95, sum(rate(orion_http_requests_duration_seconds_bucket[5m])) by (le))", "legendFormat": "P95", "refId": "B"},
        {"expr": "histogram_quantile(0.99, sum(rate(orion_http_requests_duration_seconds_bucket[5m])) by (le))", "legendFormat": "P99", "refId": "C"}
      ]
    },
    {
      "id": 12,
      "type": "row",
      "title": "Error Analysis",
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 18}
    },
    {
      "id": 13,
      "type": "barchart",
      "title": "Error Rate by Status Group",
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 19},
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "calcs": ["sum"]}, "tooltip": {"mode": "single"}, "orientation": "auto", "barWidth": 0.9},
      "fieldConfig": {"defaults": {"unit": "ops", "color": {"mode": "palette-classic"}}, "overrides": []},
      "targets": [{"expr": "sum(rate(orion_http_requests_errors_total[5m])) by (handler)", "legendFormat": "{{handler}}", "refId": "A"}]
    },
    {
      "id": 14,
      "type": "barchart",
      "title": "Top Handlers by Request Volume",
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 19},
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "calcs": ["sum"]}, "tooltip": {"mode": "single"}, "orientation": "auto", "barWidth": 0.9, "order": "desc"},
      "fieldConfig": {"defaults": {"unit": "ops", "color": {"mode": "palette-classic"}}, "overrides": []},
      "targets": [{"expr": "topk(10, sum(rate(orion_http_requests_total[5m])) by (handler))", "legendFormat": "{{handler}}", "refId": "A"}]
    },
    {
      "id": 15,
      "type": "table",
      "title": "HTTP Status Code Distribution (5m)",
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 19},
      "options": {"showHeader": true, "columns": [], "frameOptions": {"showHeader": true}},
      "fieldConfig": {
        "defaults": {"color": {"mode": "thresholds"}, "custom": {"align": "left", "displayMode": "auto", "inspect": false}},
        "overrides": [
          {"matcher": {"id": "byName", "options": "Status"}, "properties": [{"id": "custom.width", "value": 80}]},
          {"matcher": {"id": "byName", "options": "Rate (ops)"}, "properties": [{"id": "custom.width", "value": 100}]}
        ]
      },
      "targets": [{"expr": "sum(rate(orion_http_requests_total[5m])) by (status)", "format": "table", "instant": true, "refId": "A"}]
    }
  ],
  "templating": {"list": []}
}
