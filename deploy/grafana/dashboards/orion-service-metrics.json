{
  "uid": "orion-service-metrics-v1",
  "title": "Orion Service Metrics",
  "description": "Orion service metrics: request rate, latency (P50/P95/P99), error rate, CPU/memory per module, DB query time, error count by module",
  "tags": ["orion", "service", "metrics"],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 0,
  "refresh": "30s",
  "schemaVersion": 38,
  "version": 1,
  "links": [],
  "liveNow": false,
  "templating": {
    "list": [
      {
        "name": "handler",
        "type": "query",
        "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
        "query": "label_values(orion_http_requests_total, handler)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "label": "Module (handler)",
        "hide": 0,
        "allValue": ".+"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Request Rate & Error Rate",
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0}
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Request Rate (5m)",
      "gridPos": {"h": 4, "w": 4, "x": 0, "y": 1},
      "options": {
        "colorMode": "value",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "values": false, "missing": "hide"},
        "showThresholdLabels": false,
        "showThresholdMarkers": false
      },
      "fieldConfig": {
        "defaults": {"unit": "ops", "color": {"mode": "thresholds"}},
        "overrides": []
      },
      "targets": [{"expr": "sum(rate(orion_http_requests_total{handler=~\"$handler\"}[5m]))", "refId": "A"}]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Success Rate (5m)",
      "gridPos": {"h": 4, "w": 4, "x": 4, "y": 1},
      "options": {
        "colorMode": "background",
        "textMode": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "values": false, "missing": "hide"},
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 3,
          "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "orange", "value": 0.95}, {"color": "green", "value": 0.99}]},
          "color": {"mode": "thresholds"}
        },
        "overrides": []
      },
      "targets": [{"expr": "sum(rate(orion_http_requests_total{handler=~\"$handler\",status=~\"2..|3..\"}[5m])) / sum(rate(orion_http_requests_total{handler=~\"$handler\"}[5m]))", "refId": "A"}]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Error Rate (5m)",
      "gridPos": {"h": 4, "w": 4, "x": 8, "y": 1},
      "options": {
        "colorMode": "background",
        "textMode": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "values": false, "missing": "hide"},
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 3,
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 0.01}, {"color": "red", "value": 0.05}]},
          "color": {"mode": "thresholds"}
        },
        "overrides": []
      },
      "targets": [{"expr": "sum(rate(orion_http_requests_total{handler=~\"$handler\",status=~\"4..|5..\"}[5m])) / sum(rate(orion_http_requests_total{handler=~\"$handler\"}[5m]))", "refId": "A"}]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Request Rate Over Time",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 5},
      "options": {
        "legend": {"displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"]},
        "tooltip": {"mode": "multi", "sort": "none"},
        "seriesOverrides": []
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": {"mode": "palette-classic"},
          "custom": {"axisCenteredZero": false, "axisColorMode": "text", "axisPlacement": "auto", "barAlignment": 0, "drawStyle": "line", "fillOpacity": 10, "gradientMode": "none", "lineInterpolation": "linear", "lineWidth": 1, "pointSize": 5, "scaleDistribution": {"type": "linear"}, "showPoints": "never", "spanNulls": false, "stacking": {"group": "A", "mode": "none"}, "thresholdsStyle": {"mode": "off"}}
        },
        "overrides": []
      },
      "targets": [
        {"expr": "sum(rate(orion_http_requests_total{handler=~\"$handler\"}[5m]))", "legendFormat": "Total", "refId": "A"},
        {"expr": "sum(rate(orion_http_requests_total{handler=~\"$handler\",status=~\"2..|3..\"}[5m]))", "legendFormat": "Success", "refId": "B"},
        {"expr": "sum(rate(orion_http_requests_total{handler=~\"$handler\",status=~\"4..\"}[5m]))", "legendFormat": "4xx", "refId": "C"},
        {"expr": "sum(rate(orion_http_requests_total{handler=~\"$handler\",status=~\"5..\"}[5m]))", "legendFormat": "5xx", "refId": "D"}
      ]
    },
    {
      "id": 6,
      "type": "row",
      "title": "Latency (P50 / P95 / P99)",
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 14}
    },
    {
      "id": 7,
      "type": "stat",
      "title": "P50 Latency (5m)",
      "gridPos": {"h": 4, "w": 4, "x": 0, "y": 15},
      "options": {
        "colorMode": "value",
        "textMode": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "values": false, "missing": "hide"},
        "showThresholdLabels": false,
        "showThresholdMarkers": false
      },
      "fieldConfig": {"defaults": {"unit": "s", "decimals": 4, "color": {"mode": "thresholds"}}, "overrides": []},
      "targets": [{"expr": "histogram_quantile(0.50, sum(rate(orion_http_requests_duration_seconds_bucket{handler=~\"$handler\"}[5m])) by (le))", "refId": "A"}]
    },
    {
      "id": 8,
      "type": "stat",
      "title": "P95 Latency (5m)",
      "gridPos": {"h": 4, "w": 4, "x": 4, "y": 15},
      "options": {
        "colorMode": "value",
        "textMode": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "values": false, "missing": "hide"},
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 4,
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 0.5}, {"color": "red", "value": 1.0}]},
          "color": {"mode": "thresholds"}
        },
        "overrides": []
      },
      "targets": [{"expr": "histogram_quantile(0.95, sum(rate(orion_http_requests_duration_seconds_bucket{handler=~\"$handler\"}[5m])) by (le))", "refId": "A"}]
    },
    {
      "id": 9,
      "type": "stat",
      "title": "P99 Latency (5m)",
      "gridPos": {"h": 4, "w": 4, "x": 8, "y": 15},
      "options": {
        "colorMode": "value",
        "textMode": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "values": false, "missing": "hide"},
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 4,
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 1.0}, {"color": "red", "value": 5.0}]},
          "color": {"mode": "thresholds"}
        },
        "overrides": []
      },
      "targets": [{"expr": "histogram_quantile(0.99, sum(rate(orion_http_requests_duration_seconds_bucket{handler=~\"$handler\"}[5m])) by (le))", "refId": "A"}]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Latency Percentiles Over Time",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 19},
      "options": {
        "legend": {"displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"]},
        "tooltip": {"mode": "multi", "sort": "none"},
        "seriesOverrides": []
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {"mode": "palette-classic"},
          "custom": {"axisCenteredZero": false, "axisColorMode": "text", "axisPlacement": "auto", "barAlignment": 0, "drawStyle": "line", "fillOpacity": 10, "gradientMode": "none", "lineInterpolation": "linear", "lineWidth": 1, "pointSize": 5, "scaleDistribution": {"type": "linear"}, "showPoints": "never", "spanNulls": false, "stacking": {"group": "A", "mode": "none"}, "thresholdsStyle": {"mode": "off"}}
        },
        "overrides": []
      },
      "targets": [
        {"expr": "histogram_quantile(0.50, sum(rate(orion_http_requests_duration_seconds_bucket{handler=~\"$handler\"}[5m])) by (le))", "legendFormat": "P50", "refId": "A"},
        {"expr": "histogram_quantile(0.95, sum(rate(orion_http_requests_duration_seconds_bucket{handler=~\"$handler\"}[5m])) by (le))", "legendFormat": "P95", "refId": "B"},
        {"expr": "histogram_quantile(0.99, sum(rate(orion_http_requests_duration_seconds_bucket{handler=~\"$handler\"}[5m])) by (le))", "legendFormat": "P99", "refId": "C"}
      ]
    },
    {
      "id": 11,
      "type": "row",
      "title": "Resource Usage (CPU / Memory per Module)",
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 28}
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "CPU Usage by Module",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 29},
      "options": {
        "legend": {"displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"]},
        "tooltip": {"mode": "multi", "sort": "none"},
        "seriesOverrides": []
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {"mode": "palette-classic"},
          "custom": {"drawStyle": "line", "fillOpacity": 10, "gradientMode": "none", "lineWidth": 1, "showPoints": "never", "spanNulls": false, "stacking": {"group": "A", "mode": "none"}, "thresholdsStyle": {"mode": "line"}},
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 0.7}, {"color": "red", "value": 0.9}]}
        },
        "overrides": []
      },
      "targets": [{"expr": "avg(rate(container_cpu_usage_seconds_total{container_name=~\"orion-.*\"}[5m])) by (container_name)", "legendFormat": "{{container_name}}", "refId": "A"}]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Memory Usage by Module",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 29},
      "options": {
        "legend": {"displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"]},
        "tooltip": {"mode": "multi", "sort": "none"},
        "seriesOverrides": []
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": {"mode": "palette-classic"},
          "custom": {"drawStyle": "line", "fillOpacity": 10, "gradientMode": "none", "lineWidth": 1, "showPoints": "never", "spanNulls": false, "stacking": {"group": "A", "mode": "none"}, "thresholdsStyle": {"mode": "line"}}
        },
        "overrides": []
      },
      "targets": [{"expr": "avg(container_memory_working_set_bytes{container_name=~\"orion-.*\"}) by (container_name)", "legendFormat": "{{container_name}}", "refId": "A"}]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Memory % of Limit by Module",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 37},
      "options": {
        "legend": {"displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"]},
        "tooltip": {"mode": "multi", "sort": "none"},
        "seriesOverrides": []
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {"mode": "palette-classic"},
          "custom": {"drawStyle": "line", "fillOpacity": 10, "gradientMode": "none", "lineWidth": 1, "showPoints": "never", "spanNulls": false, "stacking": {"group": "A", "mode": "none"}, "thresholdsStyle": {"mode": "line"}},
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 0.85}, {"color": "red", "value": 0.95}]}
        },
        "overrides": []
      },
      "targets": [{"expr": "avg(container_memory_working_set_bytes{container_name=~\"orion-.*\"}) by (container_name) / avg(container_memory_limit_bytes{container_name=~\"orion-.*\"}) by (container_name)", "legendFormat": "{{container_name}}", "refId": "A"}]
    },
    {
      "id": 15,
      "type": "table",
      "title": "Resource Summary by Module",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 37},
      "options": {"showHeader": true, "columns": [], "frameOptions": {"showHeader": true}},
      "fieldConfig": {
        "defaults": {"color": {"mode": "thresholds"}, "custom": {"align": "left", "displayMode": "auto", "inspect": false}},
        "overrides": [
          {"matcher": {"id": "byName", "options": "Memory %"}, "properties": [{"id": "custom.displayMode", "value": "color-background"}]},
          {"matcher": {"id": "byName", "options": "CPU"}, "properties": [{"id": "custom.displayMode", "value": "color-background"}]}
        ]
      },
      "targets": [
        {"expr": "avg(container_memory_working_set_bytes{container_name=~\"orion-.*\"}) by (container_name) / avg(container_memory_limit_bytes{container_name=~\"orion-.*\"}) by (container_name) * 100", "format": "table", "instant": true, "refId": "A"},
        {"expr": "avg(rate(container_cpu_usage_seconds_total{container_name=~\"orion-.*\"}[5m])) by (container_name) * 100", "format": "table", "instant": true, "refId": "B"}
      ]
    },
    {
      "id": 16,
      "type": "row",
      "title": "Database Query Time",
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 45}
    },
    {
      "id": 17,
      "type": "stat",
      "title": "DB Query Avg (5m)",
      "gridPos": {"h": 4, "w": 4, "x": 0, "y": 46},
      "options": {"colorMode": "value", "textMode": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "values": false, "missing": "hide"}, "showThresholdLabels": false, "showThresholdMarkers": false},
      "fieldConfig": {"defaults": {"unit": "s", "decimals": 4, "color": {"mode": "thresholds"}}, "overrides": []},
      "targets": [{"expr": "avg(rate(orion_db_query_duration_seconds_sum[5m]) / rate(orion_db_query_duration_seconds_count[5m]))", "refId": "A"}]
    },
    {
      "id": 18,
      "type": "stat",
      "title": "DB Query P99 (5m)",
      "gridPos": {"h": 4, "w": 4, "x": 4, "y": 46},
      "options": {"colorMode": "value", "textMode": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "values": false, "missing": "hide"}, "showThresholdLabels": false, "showThresholdMarkers": true},
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 4,
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 0.3}, {"color": "red", "value": 1.0}]},
          "color": {"mode": "thresholds"}
        },
        "overrides": []
      },
      "targets": [{"expr": "histogram_quantile(0.99, sum(rate(orion_db_query_duration_seconds_bucket[5m])) by (le))", "refId": "A"}]
    },
    {
      "id": 19,
      "type": "timeseries",
      "title": "DB Query Duration Distribution",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 50},
      "options": {
        "legend": {"displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"]},
        "tooltip": {"mode": "multi", "sort": "none"},
        "seriesOverrides": []
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {"mode": "palette-classic"},
          "custom": {"axisCenteredZero": false, "axisColorMode": "text", "axisPlacement": "auto", "barAlignment": 0, "drawStyle": "line", "fillOpacity": 10, "gradientMode": "none", "lineInterpolation": "linear", "lineWidth": 1, "pointSize": 5, "scaleDistribution": {"type": "linear"}, "showPoints": "never", "spanNulls": false, "stacking": {"group": "A", "mode": "none"}, "thresholdsStyle": {"mode": "off"}}
        },
        "overrides": []
      },
      "targets": [
        {"expr": "histogram_quantile(0.50, sum(rate(orion_db_query_duration_seconds_bucket[5m])) by (le))", "legendFormat": "P50", "refId": "A"},
        {"expr": "histogram_quantile(0.95, sum(rate(orion_db_query_duration_seconds_bucket[5m])) by (le))", "legendFormat": "P95", "refId": "B"},
        {"expr": "histogram_quantile(0.99, sum(rate(orion_db_query_duration_seconds_bucket[5m])) by (le))", "legendFormat": "P99", "refId": "C"}
      ]
    },
    {
      "id": 20,
      "type": "timeseries",
      "title": "DB Query Rate by Handler",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 50},
      "options": {
        "legend": {"displayMode": "table", "placement": "bottom", "calcs": ["sum"]},
        "tooltip": {"mode": "multi", "sort": "none"},
        "seriesOverrides": []
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": {"mode": "palette-classic"},
          "custom": {"drawStyle": "line", "fillOpacity": 10, "gradientMode": "none", "lineWidth": 1, "showPoints": "never", "spanNulls": false, "stacking": {"group": "A", "mode": "none"}, "thresholdsStyle": {"mode": "off"}}
        },
        "overrides": []
      },
      "targets": [{"expr": "topk(15, sum(rate(orion_db_query_duration_seconds_count[5m])) by (handler))", "legendFormat": "{{handler}}", "refId": "A"}]
    },
    {
      "id": 21,
      "type": "row",
      "title": "Error Count by Module",
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 59}
    },
    {
      "id": 22,
      "type": "barchart",
      "title": "Error Count by Module (5m)",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 60},
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "calcs": ["sum"]}, "tooltip": {"mode": "single"}, "orientation": "auto", "barWidth": 0.9, "order": "desc"},
      "fieldConfig": {"defaults": {"unit": "ops", "color": {"mode": "palette-classic"}}, "overrides": []},
      "targets": [{"expr": "topk(15, sum(rate(orion_http_requests_errors_total{handler=~\"$handler\"}[5m])) by (handler))", "legendFormat": "{{handler}}", "refId": "A"}]
    },
    {
      "id": 23,
      "type": "barchart",
      "title": "5xx Error Count by Module (5m)",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 60},
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "calcs": ["sum"]}, "tooltip": {"mode": "single"}, "orientation": "auto", "barWidth": 0.9, "order": "desc"},
      "fieldConfig": {"defaults": {"unit": "ops", "color": {"mode": "palette-classic"}}, "overrides": []},
      "targets": [{"expr": "topk(15, sum(rate(orion_http_requests_total{handler=~\"$handler\",status=~\"5..\"}[5m])) by (handler))", "legendFormat": "{{handler}}", "refId": "A"}]
    },
    {
      "id": 24,
      "type": "table",
      "title": "Error Detail by Module",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 68},
      "options": {"showHeader": true, "columns": [], "frameOptions": {"showHeader": true}},
      "fieldConfig": {
        "defaults": {"color": {"mode": "thresholds"}, "custom": {"align": "left", "displayMode": "auto", "inspect": false}},
        "overrides": [
          {"matcher": {"id": "byName", "options": "Error Rate"}, "properties": [{"id": "custom.displayMode", "value": "color-background"}]},
          {"matcher": {"id": "byName", "options": "5xx Rate"}, "properties": [{"id": "custom.displayMode", "value": "color-background"}]}
        ]
      },
      "targets": [
        {"expr": "sum(rate(orion_http_requests_errors_total{handler=~\"$handler\"}[5m])) by (handler)", "format": "table", "instant": true, "refId": "A"},
        {"expr": "sum(rate(orion_http_requests_total{handler=~\"$handler\",status=~\"5..\"}[5m])) by (handler) / sum(rate(orion_http_requests_total{handler=~\"$handler\"}[5m])) by (handler)", "format": "table", "instant": true, "refId": "B"},
        {"expr": "sum(rate(orion_http_requests_total{handler=~\"$handler\",status=~\"4..\"}[5m])) by (handler) / sum(rate(orion_http_requests_total{handler=~\"$handler\"}[5m])) by (handler)", "format": "table", "instant": true, "refId": "C"}
      ]
    }
  ]
}
