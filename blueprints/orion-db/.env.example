# PostgreSQL 配置
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=orion_app
POSTGRES_PASSWORD=orion_app_password
POSTGRES_DB=orion_tenant_db

# PostgreSQL 超级用户（用于初始化）
POSTGRES_SUPER_USER=postgres
POSTGRES_SUPER_PASSWORD=postgres_password

# Redis 配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_password

# Redis Sentinel 配置
REDIS_SENTINEL_HOSTS=localhost:26379,localhost:26380,localhost:26381
REDIS_SENTINEL_MASTER_NAME=mymaster

# 应用配置
APP_ENV=development
