# Server Configuration
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# CORS
CORS_ORIGIN=*

# Database
DATABASE_URL=postgresql://orion:orion_dev_pass@localhost:5432/orion_deploy

# Redis
REDIS_URL=redis://localhost:6379

# Service Dependencies
# orion-pipeline-svc: Pipeline trigger service
PIPELINE_SERVICE_URL=http://localhost:3001
# orion-monitor-svc: Monitoring and metrics service
MONITOR_SERVICE_URL=http://localhost:3002
# orion-platform-core: Tenant and project management
PLATFORM_CORE_URL=http://localhost:3003

# Authentication (if applicable)
# JWT_SECRET=your-secret-here
# AUTH_SERVICE_URL=http://localhost:3004
