{
  "name": "@orion/governance-svc",
  "version": "1.0.0",
  "description": "Orion Platform - API Governance Service",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "biome check src/",
    "format": "biome format src/ --write",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsx src/utils/database.ts migrate",
    "db:seed": "tsx src/utils/database.ts seed"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^12.0.0",
    "@fastify/rate-limit": "^10.1.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "zod": "^3.24.1",
    "semver": "^7.6.3",
    "uuid": "^11.0.3"
  },
  "devDependencies": {
    "@types/pg": "^8.11.10",
    "@types/semver": "^7.5.8",
    "@types/uuid": "^10.0.0",
    "typescript": "^5.7.2",
    "tsx": "^4.19.2",
    "vitest": "^2.1.8",
    "@biomejs/biome": "^1.9.4"
  }
}
