# Orion Governance Service - Environment Variables
# Copy to .env and fill in actual values

# Server
PORT=3030
HOST=0.0.0.0
NODE_ENV=development

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=orion_governance
DB_USER=orion
DB_PASSWORD=changeme
DB_POOL_MIN=2
DB_POOL_MAX=10

# JWT / Auth
JWT_SECRET=changeme-use-a-strong-secret

# Logging
LOG_LEVEL=info
LOG_PRETTY=true

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# CORS
CORS_ORIGIN=http://localhost:3000

# Feature Flags
GOVERNANCE_STRICT_MODE=false
AUTO_DEPRECATION_DAYS=180
