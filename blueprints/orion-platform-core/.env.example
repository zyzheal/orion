# Server Configuration
NODE_ENV=development
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=debug
BASE_URL=http://localhost:3001
CORS_ORIGIN=*

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute

# PostgreSQL
DATABASE_URL=postgresql://orion:orion_secret@localhost:5432/platform_db

# Redis (caching)
REDIS_URL=redis://:redis_secret@localhost:6379/0

# NATS (event bus)
NATS_URL=nats://:nats_secret@localhost:4222

# JWT
JWT_SECRET=change-me-to-a-secure-random-string
JWT_EXPIRES_IN=24h

# Database Connection Pool
DB_MAX_CONNECTIONS=20

# Migrations
RUN_MIGRATIONS=true
