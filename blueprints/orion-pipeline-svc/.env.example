# Orion Pipeline Service Environment Variables

# Server
NODE_ENV=development
PORT=3100
HOST=0.0.0.0

# Logging
LOG_LEVEL=debug
LOG_PRETTY=true

# Redis (for run state and SSE pub/sub)
REDIS_URL=redis://localhost:6379

# Orion Platform Core (tenant, project management)
PLATFORM_CORE_URL=http://localhost:3000
PLATFORM_CORE_API_KEY=

# Orion Agent Service (task execution)
AGENT_SVC_URL=http://localhost:3200
AGENT_SVC_API_KEY=

# Orion Gateway (API entry point)
GATEWAY_URL=http://localhost:8080

# Pipeline Engine
PIPELINE_MAX_CONCURRENT_RUNS=10
PIPELINE_RUN_TIMEOUT_MS=3600000
PIPELINE_LOG_RETENTION_DAYS=30

# Authentication (if applicable)
AUTH_STRATEGY=bearer
AUTH_JWT_SECRET=
