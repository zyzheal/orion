# Orion Platform Environment Configuration
# Copy this file to .env and adjust values as needed
#
# SECURITY: In production, never commit .env with real secrets.
# Use Docker secrets, Vault, or CI/CD secret management instead.

# JWT Secret (REQUIRED - must be at least 32 characters in production)
JWT_SECRET=

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=orion
DB_PASSWORD=
DB_NAME=orion

# Redis (optional)
REDIS_HOST=localhost
REDIS_PORT=6379

# NATS (optional)
NATS_ENABLED=false
NATS_SERVERS=nats://localhost:4222

# Node
NODE_ENV=development
LOG_LEVEL=info
