# Orion Platform Environment Configuration
# Copy this file to .env and adjust values as needed
#
# SECURITY: In production, never commit .env with real secrets.
# Use Docker secrets, Vault, or CI/CD secret management instead.

# ==================== Shared Configuration ====================

# JWT Secret (REQUIRED — MUST be identical across platform-service and api-gateway)
# Both services read from process.env.JWT_SECRET. If they differ, tokens
# issued by one service will fail validation in the other.
JWT_SECRET=your-256-bit-secret-key-here-use-at-least-32-characters

# ==================== Platform Service ====================

PLATFORM_SERVICE_URL=http://localhost:3001
PLATFORM_TIMEOUT=30000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=orion
DB_PASSWORD=
DB_NAME=orion

# ==================== API Gateway ====================

# Redis (for Gateway session management and token revocation)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ==================== NATS (Event Bus) ====================

NATS_ENABLED=true
NATS_SERVERS=nats://localhost:4222
EVENT_BUS_ENABLED=true

# ==================== Node ====================

NODE_ENV=development
LOG_LEVEL=info
