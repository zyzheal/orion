# ==========================================
# Orion Microservices - 全局环境变量
# 复制此文件为 .env 并填入实际值
# ==========================================

# --- 项目配置 ---
COMPOSE_PROJECT_NAME=orion
NODE_ENV=production

# --- PostgreSQL ---
POSTGRES_USER=orion
POSTGRES_PASSWORD=orion_secret
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PASSWORD=redis_secret
REDIS_PORT=6379
REDIS_MAXMEMORY=256mb

# --- NATS JetStream ---
NATS_TOKEN=nats_secret
NATS_PORT=4222
NATS_MANAGEMENT_PORT=8222

# --- JWT ---
JWT_SECRET=change-me-in-production

# --- 日志 ---
LOG_LEVEL=info

# ==========================================
# 服务端口映射
# ==========================================
GATEWAY_PORT=3000
PLATFORM_PORT=3001
PIPELINE_PORT=3002
DEPLOY_PORT=3003
TICKET_PORT=3004
MONITOR_PORT=3005
INTELLIGENCE_PORT=3006
AGENT_PORT=3007
KNOWLEDGE_PORT=3008

# ==========================================
# 镜像版本标签
# ==========================================
GATEWAY_VERSION=latest
PLATFORM_VERSION=latest
PIPELINE_VERSION=latest
DEPLOY_VERSION=latest
TICKET_VERSION=latest
MONITOR_VERSION=latest
INTELLIGENCE_VERSION=latest
AGENT_VERSION=latest
KNOWLEDGE_VERSION=latest
