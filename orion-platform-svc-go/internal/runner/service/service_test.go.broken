package service

import (
	"context"
	"database/sql"
	"database/sql/driver"
	"testing"
	"time"

	"orion/platform-svc-go/internal/runner/models"
	"orion/platform-svc-go/internal/runner/repository"

	"github.com/DATA-DOG/go-sqlmock"
	"github.com/jmoiron/sqlx"
)

// ---------------------------------------------------------------------------
// Helper: newSQLMockTest returns (ctx, *Repository, *Service, sqlmock.Sqlmock)
// ---------------------------------------------------------------------------

func newSQLMockTest(t *testing.T) (context.Context, *repository.Repository, *Service, sqlmock.Sqlmock) {
	t.Helper()
	mockDB, mock, err := sqlmock.New()
	if err != nil {
		t.Fatalf("failed to create sqlmock: %v", err)
	}
	sqlxDB := sqlx.NewDb(mockDB, "sqlmock")
	repo := repository.NewRepository(sqlxDB)
	svc := NewService(repo)
	return context.Background(), repo, svc, mock
}

// agentColumns are the columns for the SELECT * FROM runner_agents result set.
var agentColumns = []string{
	"id", "agent_id", "tenant_id", "name", "labels", "endpoint",
	"max_concurrent", "status", "metadata", "last_heartbeat_at", "created_at", "updated_at",
}

// makeAgentRow builds a single runner_agents row for sqlmock.
func makeAgentRow(id, agentID, tenantID, name, endpoint, status string, maxConcurrent int, labels, metadata string) []driver.Value {
	now := time.Now().UTC()
	return []driver.Value{
		id, agentID, tenantID, name, labels, endpoint, maxConcurrent, status, metadata, nil, now, now,
	}
}

// jobColumns are the columns for the SELECT * FROM runner_jobs result set.
var jobColumns = []string{
	"id", "job_id", "agent_id", "tenant_id", "task_type", "task_parameters",
	"status", "result", "stdout", "stderr", "exit_code", "duration_ms",
	"error_message", "started_at", "completed_at", "created_at",
}

// makeJobRow builds a single runner_jobs row for sqlmock.
func makeJobRow(id, jobID, agentID, tenantID, taskType, status, params string) []driver.Value {
	now := time.Now().UTC()
	return []driver.Value{
		id, jobID, agentID, tenantID, taskType, params, status, nil, nil, nil, nil, nil, nil, nil, nil, now,
	}
}

// ===========================================================================
// RegisterAgent tests
// ===========================================================================

func TestRegisterAgent_Success(t *testing.T) {
	ctx, _, svc, mock := newSQLMockTest(t)
	agentID := "my-runner"
	tenantID := "tenant-1"

	// 1st SELECT (GetAgentByAgentID) returns no rows → new registration
	mock.ExpectQuery("SELECT.*FROM runner_agents").
		WithArgs(agentID).
		WillReturnRows(sqlmock.NewRows(agentColumns))

	// INSERT (CreateAgent)
	mock.ExpectBegin()
	mock.ExpectExec("INSERT INTO runner_agents").
		WillReturnResult(sqlmock.NewResult(1, 1))
	mock.ExpectCommit()

	// UPDATE status→online (UpdateAgent after create)
	mock.ExpectExec("UPDATE runner_agents SET").
		WithArgs("online", "runner-agent-01").
		WillReturnResult(sqlmock.NewResult(1, 1))

	req := &models.CreateAgentRequest{
		Name:          agentID,
		Labels:        []string{"linux", "nodejs"},
		Endpoint:      "http://runner:3028",
		MaxConcurrent: 5,
	}
	agent, err := svc.RegisterAgent(ctx, tenantID, req)
	if err != nil {
		t.Fatalf("RegisterAgent returned error: %v", err)
	}
	if agent.AgentID != agentID {
		t.Errorf("expected agentID %q, got %q", agentID, agent.AgentID)
	}
	if agent.Status != "online" {
		t.Errorf("expected status online, got %q", agent.Status)
	}
}

func TestRegisterAgent_ReRegisterSetsOnline(t *testing.T) {
	ctx, _, svc, mock := newSQLMockTest(t)
	agentID := "existing-runner"
	// SELECT returns an existing agent → re-registration path
	mock.ExpectQuery("SELECT.*FROM runner_agents").
		WithArgs(agentID).
		WillReturnRows(sqlmock.NewRows(agentColumns).
			AddRow(makeAgentRow("a-1", agentID, "tenant-1", agentID, "http://r:3028", "offline", 5, `["linux"]`, `{}`)...))
	// UPDATE sets status to online
	mock.ExpectExec("UPDATE runner_agents SET").
		WithArgs("online", "a-1").
		WillReturnResult(sqlmock.NewResult(1, 1))

	req := &models.CreateAgentRequest{
		Name:     agentID,
		Endpoint: "http://r:3029",
	}
	agent, err := svc.RegisterAgent(ctx, "tenant-1", req)
	if err != nil {
		t.Fatalf("RegisterAgent returned error: %v", err)
	}
	if agent.AgentID != agentID {
		t.Errorf("expected %q, got %q", agentID, agent.AgentID)
	}
}

func TestRegisterAgent_DefaultMaxConcurrent(t *testing.T) {
	ctx, _, svc, mock := newSQLMockTest(t)
	agentID := "default-runner"
	mock.ExpectQuery("SELECT.*FROM runner_agents").
		WithArgs(agentID).
		WillReturnRows(sqlmock.NewRows(agentColumns))
	mock.ExpectBegin()
	mock.ExpectExec("INSERT INTO runner_agents").
		WithArgs(sqlmock.AnyArg(), agentID, sqlmock.AnyArg(), sqlmock.AnyArg(), sqlmock.AnyArg(), sqlmock.AnyArg(), 5).
		WillReturnResult(sqlmock.NewResult(1, 1))
	mock.ExpectCommit()
	mock.ExpectExec("UPDATE runner_agents SET").WillReturnResult(sqlmock.NewResult(1, 1))

	req := &models.CreateAgentRequest{
		Name:     agentID,
		Endpoint: "http://r:3030",
		// MaxConcurrent not set → defaults to 5
	}
	agent, err := svc.RegisterAgent(ctx, "tenant-1", req)
	if err != nil {
		t.Fatalf("RegisterAgent returned error: %v", err)
	}
	if agent.MaxConcurrent != 5 {
		t.Errorf("expected MaxConcurrent 5, got %d", agent.MaxConcurrent)
	}
}

func TestRegisterAgent_CreateFails(t *testing.T) {
	ctx, _, svc, mock := newSQLMockTest(t)
	agentID := "fail-runner"
	mock.ExpectQuery("SELECT.*FROM runner_agents").
		WithArgs(agentID).
		WillReturnRows(sqlmock.NewRows(agentColumns))
	mock.ExpectBegin()
	mock.ExpectExec("INSERT INTO runner_agents").
		WillReturnError(context.DeadlineExceeded)
	mock.ExpectRollback()

	req := &models.CreateAgentRequest{
		Name:     agentID,
		Endpoint: "http://r:3031",
	}
	_, err := svc.RegisterAgent(ctx, "tenant-1", req)
	if err == nil {
		t.Fatal("expected error for create failure")
	}
}

// ===========================================================================
// GetAgent tests
// ===========================================================================

func TestGetAgent_Success(t *testing.T) {
	ctx, _, svc, mock := newSQLMockTest(t)
	agentID := "runner-1"

	mock.ExpectQuery("SELECT.*FROM runner_agents").
		WithArgs(agentID).
		WillReturnRows(sqlmock.NewRows(agentColumns).
			AddRow(makeAgentRow("a-1", agentID, "tenant-1", "My Runner", "http://r:3028", "online", 10, `["linux"]`, `{}`)...))
	mock.ExpectQuery("SELECT COUNT\\(\\*\\)").
		WithArgs("a-1", "running").
		WillReturnRows(sqlmock.NewRows([]string{"count"}).AddRow(2))

	info, err := svc.GetAgent(ctx, "tenant-1", agentID)
	if err != nil {
		t.Fatalf("GetAgent returned error: %v", err)
	}
	if info.AgentID != agentID {
		t.Errorf("expected %q, got %q", agentID, info.AgentID)
	}
	if info.Status != "online" {
		t.Errorf("expected status online, got %q", info.Status)
	}
	if info.ActiveJobs != 2 {
		t.Errorf("expected 2 active jobs, got %d", info.ActiveJobs)
	}
}

func TestGetAgent_NotFound(t *testing.T) {
	ctx, _, svc, mock := newSQLMockTest(t)
	agentID := "missing"

	mock.ExpectQuery("SELECT.*FROM runner_agents").
		WithArgs(agentID).
		WillReturnError(sql.ErrNoRows)

	_, err := svc.GetAgent(ctx, "tenant-1", agentID)
	if err == nil {
		t.Fatal("expected error for missing agent")
	}
	if err.Error() != "runner agent not found: missing" {
		t.Errorf("unexpected error: %v", err)
	}
}

