func TestListAgents_Success(t *testing.T) {
	ctx, _, svc, mock := newSQLMockTest(t)
	tenantID := "tenant-1"

	mock.ExpectQuery("SELECT.*FROM runner_agents").
		WithArgs(sqlmock.AnyArg(), sqlmock.AnyArg(), sqlmock.AnyArg()).
		WillReturnRows(sqlmock.NewRows(agentColumns).
			AddRow(makeAgentRow("a-1", "r-1", tenantID, "Runner1", "http://r1", "online", 5, `["linux"]`, `{}`)...).
			AddRow(makeAgentRow("a-2", "r-2", tenantID, "Runner2", "http://r2", "offline", 3, `["mac"]`, `{}`)...))

	agents, err := svc.ListAgents(ctx, tenantID, 0, 10)
	if err != nil {
		t.Fatalf("ListAgents returned error: %v", err)
	}
	if len(agents) != 2 {
		t.Fatalf("expected 2 agents, got %d", len(agents))
	}
	if agents[0].Name != "Runner1" {
		t.Errorf("expected Runner1, got %q", agents[0].Name)
	}
}

