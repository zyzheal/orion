// ===========================================================================
// TransitionJob tests
// ===========================================================================

func TestTransitionJob_Success(t *testing.T) {
	ctx, _, svc, mock := newSQLMockTest(t)
	jobID := "shell-job-1"
	req := &models.UpdateJobStatusRequest{
		Status: models.JobStatusRunning,
	}

	// GetJobByJobID
	mock.ExpectQuery("SELECT.*FROM runner_jobs").
		WithArgs(jobID).
		WillReturnRows(sqlmock.NewRows(jobColumns).
			AddRow(makeJobRow("j-1", jobID, "a-1", "tenant-1", "shell", "pending", `{}`)...))
	// UPDATE → RETURNING (setJobStatus)
	mock.ExpectQuery("UPDATE runner_jobs SET").
		WithArgs("running", sqlmock.AnyArg(), "j-1").
		WillReturnRows(sqlmock.NewRows(jobColumns).
			AddRow(makeJobRow("j-1", jobID, "a-1", "tenant-1", "shell", "running", `{}`)...))
	// GetJobByJobID (final fetch)
	mock.ExpectQuery("SELECT.*FROM runner_jobs").
		WithArgs(jobID).
		WillReturnRows(sqlmock.NewRows(jobColumns).
			AddRow(makeJobRow("j-1", jobID, "a-1", "tenant-1", "shell", "running", `{}`)...))

	job, err := svc.TransitionJob(ctx, "tenant-1", jobID, req)
	if err != nil {
		t.Fatalf("TransitionJob returned error: %v", err)
	}
	if job.Status != models.JobStatusRunning {
		t.Errorf("expected running, got %q", job.Status)
	}
}

func TestTransitionJob_InvalidTransition(t *testing.T) {
	ctx, _, svc, mock := newSQLMockTest(t)
	jobID := "shell-job-1"
	req := &models.UpdateJobStatusRequest{
		Status: models.JobStatusRunning,
	}

	// Job is already completed — terminal state, no forward transitions
	mock.ExpectQuery("SELECT.*FROM runner_jobs").
		WithArgs(jobID).
		WillReturnRows(sqlmock.NewRows(jobColumns).
			AddRow(makeJobRow("j-1", jobID, "a-1", "tenant-1", "shell", "completed", `{}`)...))

	_, err := svc.TransitionJob(ctx, "tenant-1", jobID, req)
	if err == nil {
		t.Fatal("expected invalid transition error")
	}
}

