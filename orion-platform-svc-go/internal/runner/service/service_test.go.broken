// ===========================================================================
// UpdateAgent tests
// ===========================================================================

func TestUpdateAgent_Success(t *testing.T) {
	ctx, _, svc, mock := newSQLMockTest(t)
	agentID := "runner-1"
	status := "draining"
	_ = models.JSONArray{"linux", "k8s"}

	// GetAgentByAgentID
	mock.ExpectQuery("SELECT.*FROM runner_agents").
		WithArgs(agentID).
		WillReturnRows(sqlmock.NewRows(agentColumns).
			AddRow(makeAgentRow("a-1", agentID, "tenant-1", "Runner", "http://r:3028", "online", 5, `["linux"]`, `{}`)...))
	// UpdateAgent
	mock.ExpectExec("UPDATE runner_agents SET").WillReturnResult(sqlmock.NewResult(1, 1))
	// GetAgentByID (fetch updated)
	mock.ExpectQuery("SELECT.*FROM runner_agents").
		WithArgs("a-1").
		WillReturnRows(sqlmock.NewRows(agentColumns).
			AddRow(makeAgentRow("a-1", agentID, "tenant-1", "Runner", "http://r:3028", "draining", 5, `["linux","k8s"]`, `{}`)...))

	req := &models.UpdateAgentRequest{
		Labels: &[]string{"linux", "k8s"},
		Status: &status,
	}
	agent, err := svc.UpdateAgent(ctx, "tenant-1", agentID, req)
	if err != nil {
		t.Fatalf("UpdateAgent returned error: %v", err)
	}
	if agent.Status != "draining" {
		t.Errorf("expected status draining, got %q", agent.Status)
	}
}

