// ===========================================================================
// CreateJob tests
// ===========================================================================

func TestCreateJob_Success(t *testing.T) {
	ctx, _, svc, mock := newSQLMockTest(t)
	agentID := "runner-1"

	// GetAgentByAgentID → verify agent exists and is online
	mock.ExpectQuery("SELECT.*FROM runner_agents").
		WithArgs(agentID).
		WillReturnRows(sqlmock.NewRows(agentColumns).
			AddRow(makeAgentRow("a-1", agentID, "tenant-1", "Runner", "http://r", "online", 5, `[]`, `{}`)...))
	// CountActiveJobsByAgent → no active jobs
	mock.ExpectQuery("SELECT COUNT\\(\\*\\)").
		WithArgs("a-1", "running").
		WillReturnRows(sqlmock.NewRows([]string{"count"}).AddRow(0))
	// CreateJob INSERT
	mock.ExpectBegin()
	mock.ExpectExec("INSERT INTO runner_jobs").WillReturnResult(sqlmock.NewResult(1, 1))
	mock.ExpectCommit()

	req := &models.CreateJobRequest{
		AgentID: agentID,
		Task: &models.TaskSpec{
			Type:    "shell",
			Command: "echo hello",
		},
	}
	job, err := svc.CreateJob(ctx, "tenant-1", req)
	if err != nil {
		t.Fatalf("CreateJob returned error: %v", err)
	}
	if job.Status != models.JobStatusPending {
		t.Errorf("expected pending status, got %q", job.Status)
	}
	if job.TaskType != "shell" {
		t.Errorf("expected shell type, got %q", job.TaskType)
	}
}

