func TestCountAgents(t *testing.T) {
	ctx, _, svc, mock := newSQLMockTest(t)
	mock.ExpectQuery("SELECT COUNT\\(\\*\\)").
		WithArgs("tenant-1").
		WillReturnRows(sqlmock.NewRows([]string{"count"}).AddRow(3))

	n, err := svc.CountAgents(ctx, "tenant-1")
	if err != nil {
		t.Fatalf("CountAgents returned error: %v", err)
	}
	if n != 3 {
		t.Errorf("expected 3, got %d", n)
	}
}

// ===========================================================================
// ReportJobResult
// ===========================================================================

func TestReportJobResult_Success(t *testing.T) {
	ctx, _, svc, mock := newSQLMockTest(t)
	jobID := "shell-1"
	stdout := "hello"
	stderr := "warn"
	exitCode := 0
	duration := 1234
	mock.ExpectQuery("SELECT.*FROM runner_jobs").
		WithArgs(jobID).
		WillReturnRows(sqlmock.NewRows(jobColumns).
			AddRow([]driver.Value{
				"j-1", jobID, "a-1", "tenant-1", "shell", "{}",
				"completed", "{}", stdout, stderr, exitCode, duration,
				nil, nil, nil, time.Now().UTC(),
			}...))

	result, err := svc.ReportJobResult(ctx, jobID)
	if err != nil {
		t.Fatalf("ReportJobResult returned error: %v", err)
	}
	if !result.Success {
		t.Error("expected success")
	}
	if result.ExitCode != 0 {
		t.Errorf("expected exit code 0, got %d", result.ExitCode)
	}
	if result.Stdout != stdout {
		t.Errorf("expected stdout %q, got %q", stdout, result.Stdout)
	}
}

// ===========================================================================
// Standalone helpers (no sqlmock)
// ===========================================================================

func TestValidateTaskParameters_EmptyType(t *testing.T) {
	errs := ValidateTaskParameters("", "", "", 0)
	if len(errs) != 1 || errs[0] != "task type is required" {
		t.Errorf("expected 'task type is required', got %v", errs)
	}
}

func TestValidateTaskParameters_UnknownType(t *testing.T) {
	errs := ValidateTaskParameters("unknown", "", "", 0)
	if len(errs) != 1 {
		t.Errorf("expected 1 error, got %v", errs)
	}
}

func TestValidateTaskParameters_ShellNoCommand(t *testing.T) {
	errs := ValidateTaskParameters("shell", "", "", 0)
	if len(errs) != 1 || errs[0] != "shell task requires command or script" {
		t.Errorf("expected shell command error, got %v", errs)
	}
}

func TestValidateTaskParameters_Valid(t *testing.T) {
	errs := ValidateTaskParameters("shell", "echo hi", "", 0)
	if len(errs) != 0 {
		t.Errorf("expected no errors, got %v", errs)
	}
}

func TestEstimateTaskDuration_Shell(t *testing.T) {
	d := EstimateTaskDuration("shell", 120000)
	if d != 60000 {
		t.Errorf("expected 60000, got %d", d)
	}
}

func TestEstimateTaskDuration_Pipeline(t *testing.T) {
	d := EstimateTaskDuration("pipeline", 0)
	if d != 300000 {
		t.Errorf("expected 300000, got %d", d)
	}
}

func TestPurgeExpiredHeartbeats(t *testing.T) {
	ctx, _, svc, mock := newSQLMockTest(t)
	mock.ExpectExec("DELETE FROM runner_heartbeats").
		WithArgs(sqlmock.AnyArg()).
		WillReturnResult(sqlmock.NewResult(5, 5))

	n, err := svc.PurgeExpiredHeartbeats(ctx, 24*time.Hour)
	if err != nil {
		t.Fatalf("PurgeExpiredHeartbeats returned error: %v", err)
	}
	if n != 5 {
		t.Errorf("expected 5, got %d", n)
	}
}
