# =============================================================
# orion-platform-svc-go — Development Environment
# =============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Required for the service to start. Optional fields have sensible
# defaults that match the local docker-compose.yml setup.
# =============================================================

# ---------- Database (PostgreSQL) ----------
# Full DSN connection string (preferred)
DATABASE_URL=postgres://orion:oriondev@localhost:5432/orion?sslmode=disable

# Or individual parameters (used when DATABASE_URL is empty)
DB_HOST=localhost
DB_PORT=5432
DB_USER=orion
DB_PASSWORD=oriondev
DB_NAME=orion
DB_SSLMODE=disable

# ---------- Redis ----------
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# ---------- NATS (Event Streaming) ----------
NATS_ADDR=nats://localhost:4222
NATS_STREAM=ORION_EVENTS
NATS_SUBJECT_PREFIX=orion

# ---------- JWT / Authentication ----------
JWT_SECRET=change-me-to-a-random-secret
JWT_EXPIRATION=5m
JWT_REFRESH_EXPIRATION=168h

# ---------- Service ----------
SERVICE_NAME=orion-platform-svc
ENVIRONMENT=development
HTTP_ADDR=:8080
PORT=8080
LOG_LEVEL=info

# ---------- OpenTelemetry (optional) ----------
OTEL_ENDPOINT=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_INSECURE=true

# ---------- Docker Compose (overridden by docker-compose.yml) ----------
POSTGRES_USER=orion
POSTGRES_PASSWORD=oriondev
POSTGRES_DB=orion
