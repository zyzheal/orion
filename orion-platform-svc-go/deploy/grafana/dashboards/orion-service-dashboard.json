{
  "__inputs": [],
  "__requires": [],
  "dashboard": {
    "title": "Orion Service Dashboard",
    "description": "Orion platform service metrics: QPS, latency, error rate, and resource usage. All orion_service_* metrics are defined in internal/middleware/prometheus.go.",
    "tags": ["orion", "prometheus", "service"],
    "timezone": "browser",
    "schemaVersion": 36,
    "version": 1,
    "refresh": "30s",
    "panels": [
      {
        "id": 1,
        "title": "Request Rate (QPS)",
        "type": "graph",
        "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
        "targets": [
          {
            "expr": "sum(rate(orion_http_requests_total[5m]))",
            "legendFormat": "Total QPS",
            "refId": "A"
          },
          {
            "expr": "sum(rate(orion_http_requests_total{status=~\"2xx\"}[5m]))",
            "legendFormat": "2xx",
            "refId": "B"
          },
          {
            "expr": "sum(rate(orion_http_requests_total{status=~\"4xx\"}[5m]))",
            "legendFormat": "4xx",
            "refId": "C"
          },
          {
            "expr": "sum(rate(orion_http_requests_total{status=~\"5xx\"}[5m]))",
            "legendFormat": "5xx",
            "refId": "D"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "reqps",
            "min": 0
          }
        }
      },
      {
        "id": 2,
        "title": "Latency (P50 / P95 / P99)",
        "type": "graph",
        "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
        "targets": [
          {
            "expr": "histogram_quantile(0.50, sum(rate(orion_http_requests_duration_seconds_bucket[5m])) by (le))",
            "legendFormat": "P50",
            "refId": "A"
          },
          {
            "expr": "histogram_quantile(0.95, sum(rate(orion_http_requests_duration_seconds_bucket[5m])) by (le))",
            "legendFormat": "P95",
            "refId": "B"
          },
          {
            "expr": "histogram_quantile(0.99, sum(rate(orion_http_requests_duration_seconds_bucket[5m])) by (le))",
            "legendFormat": "P99",
            "refId": "C"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "min": 0
          }
        }
      },
      {
        "id": 3,
        "title": "Error Rate",
        "type": "graph",
        "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 },
        "targets": [
          {
            "expr": "sum(rate(orion_http_requests_errors_total[5m])) / sum(rate(orion_http_requests_total[5m])) * 100",
            "legendFormat": "Error %",
            "refId": "A"
          },
          {
            "expr": "sum(rate(orion_http_requests_errors_total[5m]))",
            "legendFormat": "Error count/s",
            "refId": "B"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 0
          }
        }
      },
      {
        "id": 4,
        "title": "CPU Usage",
        "type": "graph",
        "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 },
        "targets": [
          {
            "expr": "rate(process_cpu_seconds_total{job=\"orion-service\"}[1m]) * 100",
            "legendFormat": "CPU %",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 0
          }
        }
      },
      {
        "id": 5,
        "title": "Memory Usage",
        "type": "graph",
        "gridPos": { "h": 8, "w": 8, "x": 8, "y": 8 },
        "targets": [
          {
            "expr": "go_memstats_alloc_bytes{job=\"orion-service\"}",
            "legendFormat": "Allocated",
            "refId": "A"
          },
          {
            "expr": "go_memstats_heap_inuse_bytes{job=\"orion-service\"}",
            "legendFormat": "Heap in use",
            "refId": "B"
          },
          {
            "expr": "process_resident_memory_bytes{job=\"orion-service\"}",
            "legendFormat": "RSS",
            "refId": "C"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "bytes"
          }
        }
      },
      {
        "id": 6,
        "title": "Goroutines & GC",
        "type": "graph",
        "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 },
        "targets": [
          {
            "expr": "go_goroutines{job=\"orion-service\"}",
            "legendFormat": "Goroutines",
            "refId": "A"
          },
          {
            "expr": "rate(go_gc_duration_seconds_sum{job=\"orion-service\"}[1m])",
            "legendFormat": "GC CPU/s",
            "refId": "B"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "min": 0
          }
        }
      }
    ],
    "rows": [],
    "templating": {
      "list": [
        {
          "name": "job",
          "type": "query",
          "query": "label_values(up, job)",
          "current": { "text": "orion-service", "value": "orion-service" },
          "includeAll": true,
          "multi": false,
          "refresh": 1
        }
      ]
    },
    "annotations": {
      "list": [
        {
          "name": "Deployments",
          "type": "events",
          "datasource": "Prometheus",
          "expr": "changes(process_start_time_seconds{job=\"orion-service\"}[1m]) > 0",
          "iconColor": "rgba(255, 96, 96, 1)",
          "enable": true
        }
      ]
    },
    "links": [],
    "time": {
      "from": "now-6h",
      "to": "now"
    }
  }
}
